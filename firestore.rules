// PROPOSED Firestore rules for Move. They are NOT applied automatically: copy them into
// Firebase console > Firestore > Rules (or `firebase deploy --only firestore:rules`).
//
// - A user's private document (email, weight, totals) and everything beneath it (their activities and GPS
//   tracks) is readable and writable only by that user.
// - The leaderboard reads `publicProfiles`, which holds just name, photo, optional username and bio, and totals. Height, weight and BMI
//   live only in the private users/{uid} document and the rules below cannot write them anywhere public.
//
// Known limit: totals are written by the client, so a determined user could fake their own leaderboard entry.
// Preventing that needs server-side validation (e.g. a Cloud Function that recomputes totals from activities).
//
// TERRITORY OWNERSHIP (territories/{areaId}) is shared, competitive state. These rules make sure that:
//   - only you can make yourself King, never anyone else;
//   - a change of King happens only as the next reign (reign + 1), so two simultaneous claims cannot both succeed;
//   - the reign start is the server's clock, not the phone's;
//   - the claim is backed, in the same transaction, by a claim proof in your own users/{uid} document whose explored
//     cells (conquest) or takeover credits (2x) meet the Territory's requirement, counted from after the current reign began;
//   - only a first name and an https photo are public; events are append-only.
// Known limit: the claim proof is computed on the phone from its own GPS tracks. A determined user could forge it.
// The data needed to check it server-side is kept (activities, tracks, mask and algorithm versions); see docs/TERRITORY.md.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // users/{uid}/activities/{activityId} and users/{uid}/activities/{activityId}/tracks/{chunk}
      match /activities/{activityId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Created once by the sync transaction; the id in the document must match its path.
        allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.id == activityId;
        allow update, delete: if false; // an activity is immutable once synced

        match /tracks/{chunk} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow create, update: if request.auth != null && request.auth.uid == uid; // idempotent retries overwrite the same chunk
          allow delete: if false;
        }
      }
    }

